# Copia este archivo como .env y completa los valores reales

# Puerto del servidor (Render lo asigna solo)
PORT=4000

# Conexión a PostgreSQL (en Render: Internal/External Database URL)
DATABASE_URL=postgres://usuario:contrasena@host:5432/american_land

# Opcional: al arrancar, el servidor aplica los .sql pendientes de backend/sql
# (quedan registrados en la tabla migraciones_aplicadas). Pon false para desactivarlo
# y aplicarlas a mano con: npm run migrar
# MIGRAR_AL_INICIAR=false

# Secreto para firmar los tokens de sesión: usa una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Dominios del frontend que pueden llamar a la API (separados por coma).
# Si se deja vacío se aceptan todos.
CORS_ORIGIN=https://tu-frontend.vercel.app,http://localhost:4000

# Carpeta donde se guardan entregas y material (en Render, un disco persistente)
UPLOADS_DIR=/var/data/uploads

# URL pública del frontend: se usa para armar el botón del correo con el código
# de recuperación de contraseña (auth/recover_pass.html)
FRONTEND_URL=https://tu-frontend.vercel.app

# ── Correo saliente (código de recuperación de contraseña) ──
# Render gratis BLOQUEA los puertos SMTP (25, 465 y 587) desde septiembre de 2025:
# ahí hay que usar la API HTTP de Brevo (https://www.brevo.com, plan gratuito).
#   1. Crea la cuenta, valida el correo remitente en "Senders" y genera una API key
#      en "SMTP & API" > "API Keys".
#   2. Pon la llave aquí y el mismo correo validado en CORREO_REMITENTE.
BREVO_API_KEY=
CORREO_REMITENTE="Instituto American Land <tu-correo@gmail.com>"

# Alternativa: SMTP (sirve en local o en un plan pago de Render). Se usa solo si
# BREVO_API_KEY está vacía. Sin ninguno de los dos, en desarrollo el correo se
# muestra en la consola y en producción (NODE_ENV=production) no se envía.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
